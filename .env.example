# WellAPI Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./wellapi.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/wellapi

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Stripe (international payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Paystack (Nigeria/Africa payments)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_key_here

# API Settings
APP_NAME=WellAPI
APP_VERSION=1.0.0
DEBUG=True
FREE_CREDITS_ON_SIGNUP=50
